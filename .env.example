# Optional. Copy to .env to override the defaults used by compose.yaml.
# Kopi Chess runs locally and the database is not exposed to the host,
# so the default password ("kopi") is fine for most people.
POSTGRES_PASSWORD=kopi

# Host port for the web UI and API (http://localhost:<port>).
KOPI_PORT=8080

# Logs: JSON lines (ecs) by default; leave it empty for plain text, easier to read by eye.
KOPI_LOG_FORMAT=ecs
# DEBUG logs every line sent to and received from Stockfish (hundreds per move).
KOPI_UCI_LOG=INFO

# Only with the metrics profile (docker compose --profile metrics up).
# Grafana's port, and the password of its "admin" user, needed only to change Grafana.
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=kopi
