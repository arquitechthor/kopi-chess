# Copy this file to keystore.properties (in this same folder, android/) and fill
# in the real values. keystore.properties is git-ignored: never commit it.
#
# storeFile: an absolute path, since the .jks lives outside this repository, in
# kopi-keys/. Use forward slashes (/), also on Windows: Java reads this file as
# a .properties file and silently eats backslashes (\U, \k... are escapes).
storeFile=C:/path/to/kopi-keys/arquitechthor.jks
storePassword=
keyAlias=
keyPassword=
