<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.arquitechthor.kopi</groupId>
    <artifactId>kopi-parent</artifactId>
    <version>0.6.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Kopi Chess</name>
    <description>Open source educational project in Chess and Code</description>
    <url>https://github.com/arquitechthor/kopi-chess</url>

    <licenses>
        <license>
            <name>GPL-3.0-or-later</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
        </license>
    </licenses>

    <!--
        Hexagonal rings, from the inside out (see docs/adr/001):
        domain <- application <- adapters <- bootstrap
    -->
    <modules>
        <module>kopi-domain</module>
        <module>kopi-application</module>
        <module>kopi-adapter-rest</module>
        <module>kopi-adapter-web</module>
        <module>kopi-adapter-persistence</module>
        <module>kopi-adapter-stockfish</module>
        <module>kopi-adapter-bots</module>
        <module>kopi-adapter-openings</module>
        <module>kopi-bootstrap</module>
        <module>kopi-architecture-tests</module>
        <!-- Preview-feature examples, outside the hexagon: nothing depends on it (ADR-012). -->
        <module>kopi-labs</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>4.1.1</spring-boot.version>
        <archunit.version>1.5.1</archunit.version>

        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>

        <!-- JUnit tags left out of local builds. The slow-tests profile (used by CI) adds "slow";
             "calibration" (bot strength, tens of minutes) only runs with -Pcalibration. -->
        <kopi.excludedTestTags>slow,calibration</kopi.excludedTestTags>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                The Spring Boot BOM is imported instead of using spring-boot-starter-parent
                as the parent, so kopi-domain and kopi-application inherit nothing from Spring.
                It also manages JUnit, AssertJ, Testcontainers, etc.
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <dependency>
                <groupId>com.arquitechthor.kopi</groupId>
                <artifactId>kopi-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.arquitechthor.kopi</groupId>
                <artifactId>kopi-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.arquitechthor.kopi</groupId>
                <artifactId>kopi-adapter-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.arquitechthor.kopi</groupId>
                <artifactId>kopi-adapter-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.arquitechthor.kopi</groupId>
                <artifactId>kopi-adapter-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.arquitechthor.kopi</groupId>
                <artifactId>kopi-adapter-stockfish</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.arquitechthor.kopi</groupId>
                <artifactId>kopi-adapter-bots</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.arquitechthor.kopi</groupId>
                <artifactId>kopi-adapter-openings</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.arquitechthor.kopi</groupId>
                <artifactId>kopi-bootstrap</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Every module gets the same test toolkit. -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <excludedGroups>${kopi.excludedTestTags}</excludedGroups>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <!--
                            Test against target/classes, not the jar: spring-boot:repackage
                            moves classes to BOOT-INF/ before failsafe runs. (spring-boot-starter-parent
                            does the same; we configure it by hand because we do not use that parent.)
                        -->
                        <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>Kopi Chess needs JDK 25 or newer. Set JAVA_HOME to a JDK 25.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Unit tests: *Test.java (surefire). Integration tests: *IT.java (failsafe). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ./mvnw verify -Pslow-tests: also run tests tagged "slow" (deep perft, differential). -->
        <profile>
            <id>slow-tests</id>
            <properties>
                <kopi.excludedTestTags>calibration</kopi.excludedTestTags>
            </properties>
        </profile>
        <!-- ./mvnw -pl kopi-bootstrap -am test -Pcalibration: only the bot calibration
             (needs Stockfish: KOPI_STOCKFISH). Results in kopi-bootstrap/target/calibration.md. -->
        <profile>
            <id>calibration</id>
            <properties>
                <kopi.excludedTestTags/>
                <groups>calibration</groups>
            </properties>
        </profile>
    </profiles>
</project>
